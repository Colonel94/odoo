<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category" model="ir.module.category">
        <field name="name">FleetFlow</field><field name="sequence">20</field>
    </record>
    <record id="group_technician" model="res.groups">
        <field name="name">Technician</field><field name="category_id" ref="module_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_dispatcher" model="res.groups">
        <field name="name">Dispatcher</field><field name="category_id" ref="module_category"/>
        <field name="implied_ids" eval="[(4, ref('group_technician'))]"/>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Operations manager</field><field name="category_id" ref="module_category"/>
        <field name="implied_ids" eval="[(4, ref('group_dispatcher'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>
    <record id="order_company_rule" model="ir.rule">
        <field name="name">FleetFlow: selected companies only</field>
        <field name="model_id" ref="model_fleetflow_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="order_technician_rule" model="ir.rule">
        <field name="name">FleetFlow: technician assigned work</field>
        <field name="model_id" ref="model_fleetflow_order"/>
        <field name="groups" eval="[(4, ref('group_technician'))]"/>
        <field name="domain_force">[('assignee_id', '=', user.id)]</field>
    </record>
    <record id="order_dispatcher_rule" model="ir.rule">
        <field name="name">FleetFlow: dispatcher company work</field>
        <field name="model_id" ref="model_fleetflow_order"/>
        <field name="groups" eval="[(4, ref('group_dispatcher'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="vehicle_company_read_rule" model="ir.rule">
        <field name="name">FleetFlow: company vehicle register</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="groups" eval="[(4, ref('group_technician'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
