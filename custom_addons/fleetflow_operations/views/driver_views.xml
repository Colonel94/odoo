<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="driver_tree" model="ir.ui.view">
        <field name="name">fleetflow.driver.tree</field>
        <field name="model">fleetflow.driver</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="employee_ref"/>
                <field name="permitted_mode"/>
                <field name="available"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="driver_form" model="ir.ui.view">
        <field name="name">fleetflow.driver.form</field>
        <field name="model">fleetflow.driver</field>
        <field name="arch" type="xml">
            <form string="Driver">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_ref"/>
                            <field name="company_id"/>
                            <field name="permitted_mode"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="user_id"/>
                            <field name="available"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Evidence" groups="fleetflow_operations.group_ops_compliance,fleetflow_operations.group_ops_fleet_manager">
                            <field name="credential_ids">
                                <tree>
                                    <field name="doc_kind"/>
                                    <field name="reference"/>
                                    <field name="date_end"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Channel enrolments">
                            <field name="channel_enrolment_ids">
                                <tree>
                                    <field name="channel"/>
                                    <field name="product"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_drivers" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">fleetflow.driver</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
