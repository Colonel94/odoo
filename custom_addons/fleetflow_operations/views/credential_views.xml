<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="credential_tree" model="ir.ui.view">
        <field name="name">fleetflow.credential.tree</field>
        <field name="model">fleetflow.credential</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'rejected'" decoration-muted="state == 'superseded'"
                  decoration-success="state == 'verified'">
                <field name="name"/>
                <field name="doc_kind"/>
                <field name="subject_kind"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="credential_form" model="ir.ui.view">
        <field name="name">fleetflow.credential.form</field>
        <field name="model">fleetflow.credential</field>
        <field name="arch" type="xml">
            <form string="Compliance evidence">
                <header>
                    <button name="action_submit" type="object" string="Submit for verification"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_verify" type="object" string="Verify" class="oe_highlight"
                            groups="fleetflow_operations.group_ops_compliance"
                            attrs="{'invisible': [('state', 'not in', ['draft', 'pending'])]}"
                            confirm="Confirm you have verified this document against its source."/>
                    <button name="action_reject" type="object" string="Reject"
                            groups="fleetflow_operations.group_ops_compliance"
                            attrs="{'invisible': [('state', 'not in', ['draft', 'pending'])]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,verified"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Document">
                            <field name="doc_kind"/>
                            <field name="issuer"/>
                            <field name="reference"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Subject (exactly one)">
                            <field name="operator_company_id"/>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                        </group>
                        <group string="Validity">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="date_precision"/>
                        </group>
                        <group string="Verification">
                            <field name="verified_by" readonly="1"/>
                            <field name="verified_on" readonly="1"/>
                            <field name="superseded_by_id" readonly="1"/>
                            <field name="supersedes_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="File (restricted)" groups="fleetflow_operations.group_ops_compliance,fleetflow_operations.group_ops_fleet_manager">
                        <field name="attachment_id"/>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="credential_search" model="ir.ui.view">
        <field name="name">fleetflow.credential.search</field>
        <field name="model">fleetflow.credential</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="pending" string="Awaiting verification" domain="[('state', 'in', ['draft', 'pending'])]"/>
                <filter name="verified" string="Verified" domain="[('state', '=', 'verified')]"/>
                <filter name="by_kind" string="Document kind" context="{'group_by': 'doc_kind'}"/>
            </search>
        </field>
    </record>

    <record id="action_credentials" model="ir.actions.act_window">
        <field name="name">Evidence</field>
        <field name="res_model">fleetflow.credential</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_compliance_queue" model="ir.actions.act_window">
        <field name="name">Compliance</field>
        <field name="res_model">fleetflow.credential</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', 'in', ['draft', 'pending'])]</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No evidence awaiting verification</p>
            <p>Documents uploaded for review appear here until verified or rejected.</p>
        </field>
    </record>
</odoo>
