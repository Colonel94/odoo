<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="allocation_form" model="ir.ui.view">
        <field name="name">fleetflow.allocation.form</field>
        <field name="model">fleetflow.allocation</field>
        <field name="arch" type="xml">
            <form string="Allocation">
                <header>
                    <button name="action_check_readiness" type="object" string="Check readiness"
                            class="btn-secondary" attrs="{'invisible': [('state', 'in', ['returned', 'cancelled'])]}"/>
                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"
                            confirm="Confirm this reservation? Readiness is re-checked and the vehicle/driver are reserved."/>
                    <button name="action_checkout" type="object" string="Check out" class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                    <button name="action_reschedule" type="object" string="Reschedule"
                            attrs="{'invisible': [('state', '!=', 'confirmed')]}"
                            confirm="Amend this confirmed plan? Readiness and conflicts are re-checked against the new interval."/>
                    <button name="action_return" type="object" string="Record return" class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'checked_out')]}"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            attrs="{'invisible': [('state', 'in', ['checked_out', 'returned', 'cancelled'])]}"
                            confirm="Cancel this allocation?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,checked_out,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Plan">
                            <field name="operating_mode"/>
                            <field name="vehicle_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="driver_id" attrs="{'readonly': [('state', '!=', 'draft')],
                                   'required': [('operating_mode', '=', 'chauffeur')]}"/>
                            <field name="channel_enrolment_ids" widget="many2many_tags"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Interval &amp; readiness">
                            <field name="planned_start" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="planned_end" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="readiness_status" widget="badge"
                                   decoration-success="readiness_status == 'ready'"
                                   decoration-warning="readiness_status == 'warning'"
                                   decoration-danger="readiness_status in ['blocked', 'needs_review']"/>
                            <field name="acknowledge_warnings"
                                   attrs="{'invisible': [('state', 'not in', ['draft', 'confirmed'])]}"/>
                            <field name="confirmed_by" readonly="1"/>
                            <label for="amend_planned_start" string="Amend to"
                                   attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                            <div attrs="{'invisible': [('state', '!=', 'confirmed')]}">
                                <field name="amend_planned_start" class="oe_inline" nolabel="1"/>
                                <span class="mx-2">→</span>
                                <field name="amend_planned_end" class="oe_inline" nolabel="1"/>
                                <p class="text-muted">Set a new interval, then use Reschedule.</p>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Custody">
                            <group>
                                <group string="Check out">
                                    <field name="custody_out_at" readonly="1"/>
                                    <label for="checkout_odometer"/>
                                    <div><field name="checkout_odometer" class="oe_inline"
                                           attrs="{'readonly': [('state', '!=', 'confirmed')]}"/>
                                        <field name="odometer_unit" class="oe_inline"/></div>
                                </group>
                                <group string="Return">
                                    <field name="custody_in_at" readonly="1"/>
                                    <field name="return_odometer" attrs="{'readonly': [('state', '!=', 'checked_out')]}"/>
                                    <field name="return_fuel" attrs="{'readonly': [('state', '!=', 'checked_out')]}"/>
                                    <field name="return_defect" attrs="{'readonly': [('state', '!=', 'checked_out')]}"/>
                                    <field name="return_condition" attrs="{'readonly': [('state', '!=', 'checked_out')]}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Decision snapshot">
                            <p class="text-muted">Frozen readiness snapshot recorded at confirmation (audit). Current readiness is checked again at checkout.</p>
                            <field name="readiness_snapshot" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="allocation_tree" model="ir.ui.view">
        <field name="name">fleetflow.allocation.tree</field>
        <field name="model">fleetflow.allocation</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'checked_out'" decoration-muted="state in ['returned', 'cancelled']">
                <field name="name"/>
                <field name="operating_mode"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="planned_start"/>
                <field name="planned_end"/>
                <field name="state" widget="badge"/>
                <field name="readiness_status" widget="badge"
                       decoration-success="readiness_status == 'ready'"
                       decoration-danger="readiness_status in ['blocked', 'needs_review']"/>
            </tree>
        </field>
    </record>

    <record id="allocation_calendar" model="ir.ui.view">
        <field name="name">fleetflow.allocation.calendar</field>
        <field name="model">fleetflow.allocation</field>
        <field name="arch" type="xml">
            <calendar string="Allocations" date_start="planned_start" date_stop="planned_end"
                      color="vehicle_id" mode="week" quick_add="false">
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="allocation_search" model="ir.ui.view">
        <field name="name">fleetflow.allocation.search</field>
        <field name="model">fleetflow.allocation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <filter name="open" string="Open" domain="[('state', 'in', ['draft', 'confirmed', 'checked_out'])]"/>
                <filter name="out" string="Out now" domain="[('state', '=', 'checked_out')]"/>
                <separator/>
                <filter name="by_state" string="State" context="{'group_by': 'state'}"/>
                <filter name="by_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_allocations" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">fleetflow.allocation</field>
        <field name="view_mode">tree,form,calendar</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Plan an assignment</p>
            <p>Pick a vehicle, driver, interval and channels, check readiness, then confirm.</p>
        </field>
    </record>

    <record id="action_today" model="ir.actions.act_window">
        <field name="name">Today</field>
        <field name="res_model">fleetflow.allocation</field>
        <field name="view_mode">calendar,tree,form</field>
        <field name="domain">[('state', 'in', ['draft', 'confirmed', 'checked_out'])]</field>
    </record>

</odoo>
