<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Custody events are immutable history: presented read-only everywhere. -->
    <record id="custody_event_tree" model="ir.ui.view">
        <field name="name">fleetflow.custody.event.tree</field>
        <field name="model">fleetflow.custody.event</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false"
                  decoration-warning="event_type == 'checkout'" decoration-info="event_type == 'return'"
                  decoration-danger="defect == True">
                <field name="event_time"/>
                <field name="event_type"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="odometer"/>
                <field name="odometer_unit"/>
                <field name="odometer_km" string="km"/>
                <field name="condition"/>
                <field name="defect"/>
                <field name="performed_by"/>
                <field name="is_legacy"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="custody_event_form" model="ir.ui.view">
        <field name="name">fleetflow.custody.event.form</field>
        <field name="model">fleetflow.custody.event</field>
        <field name="arch" type="xml">
            <form string="Custody event" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Event">
                            <field name="event_type" readonly="1"/>
                            <field name="event_time" readonly="1"/>
                            <field name="performed_by" readonly="1"/>
                            <field name="allocation_id" readonly="1"/>
                            <field name="is_legacy" readonly="1"/>
                            <field name="legacy_source" readonly="1"
                                   attrs="{'invisible': [('is_legacy', '=', False)]}"/>
                            <field name="corrects_id" readonly="1"
                                   attrs="{'invisible': [('corrects_id', '=', False)]}"/>
                            <field name="correction_reason" readonly="1"
                                   attrs="{'invisible': [('corrects_id', '=', False)]}"/>
                        </group>
                        <group string="Measurements">
                            <field name="vehicle_id" readonly="1"/>
                            <field name="driver_id" readonly="1"/>
                            <label for="odometer"/>
                            <div>
                                <field name="odometer" class="oe_inline" readonly="1"/>
                                <field name="odometer_unit" class="oe_inline" readonly="1"/>
                                (<field name="odometer_km" class="oe_inline" readonly="1"/> km)
                            </div>
                            <field name="energy_kind" readonly="1"/>
                            <field name="energy_level" readonly="1"/>
                            <field name="condition" readonly="1"/>
                            <field name="defect" readonly="1"/>
                            <field name="hold_id" readonly="1"
                                   attrs="{'invisible': [('hold_id', '=', False)]}"/>
                            <field name="order_id" readonly="1"
                                   attrs="{'invisible': [('order_id', '=', False)]}"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="custody_event_search" model="ir.ui.view">
        <field name="name">fleetflow.custody.event.search</field>
        <field name="model">fleetflow.custody.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="allocation_id"/>
                <filter name="checkouts" string="Checkouts" domain="[('event_type', '=', 'checkout')]"/>
                <filter name="returns" string="Returns" domain="[('event_type', '=', 'return')]"/>
                <filter name="defects" string="Defects" domain="[('defect', '=', True)]"/>
                <filter name="legacy" string="Legacy imported" domain="[('is_legacy', '=', True)]"/>
                <separator/>
                <filter name="by_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                <filter name="by_type" string="Event type" context="{'group_by': 'event_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_custody_events" model="ir.actions.act_window">
        <field name="name">Custody history</field>
        <field name="res_model">fleetflow.custody.event</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_by_vehicle': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No custody events yet</p>
            <p>Checkouts and returns recorded at physical handover appear here. They are immutable.</p>
        </field>
    </record>

    <!-- Expose the FleetFlow early-handover operational rule on the company. -->
    <record id="view_company_form_ff_custody" model="ir.ui.view">
        <field name="name">res.company.form.ff.custody</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <group string="FleetFlow custody">
                    <field name="ff_checkout_early_tolerance_minutes"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
